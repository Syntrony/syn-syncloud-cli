{
  "name": "synctl-dev",
  "dockerFile": "synctl-dev-server.dockerfile",
  "workspaceFolder": "/workspace",
  "runArgs": [
    "--privileged",
    "-v",
    "/var/run/docker.sock:/var/run/docker.sock"
  ],
  "remoteUser": "root",
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.Go"
      ]
    }
  }
}